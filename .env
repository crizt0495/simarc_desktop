# ═══════════════════════════════════════════════════════════════════════
#  PENYIMPANAN BERKAS DIGITAL
#  auto   = S3 bila kredensial lengkap, lalu rclone, selain itu lokal
#  local  = selalu simpan di disk perangkat
#  s3     = wajib cloud (S3-compatible: Cloudflare R2 / Backblaze B2 / MinIO)
#  rclone = wajib remote rclone (mis. Google Drive lewat `rclone config`)
# ═══════════════════════════════════════════════════════════════════════
DIGITAL_STORAGE=rclone
# Backend rclone untuk Google Drive (gratis, memakai kuota Drive yang ada).
DIGITAL_RCLONE_REMOTE=gdrive
DIGITAL_RCLONE_PATH=simarc-digital
# Opsional: kredensial khusus berkas digital. Jika kosong dipakai OFFSITE_S3_*.
# DIGITAL_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# DIGITAL_S3_BUCKET=simarc-digital
# DIGITAL_S3_ACCESS_KEY=
# DIGITAL_S3_SECRET_KEY=
# DIGITAL_S3_REGION=auto
# DIGITAL_S3_PREFIX=simarc
# DIGITAL_S3_PATH_STYLE=true
# Object Storage (dipakai berkas digital bila DIGITAL_S3_* kosong).
# OFFSITE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# OFFSITE_S3_BUCKET=simarc
# OFFSITE_S3_ACCESS_KEY=
# OFFSITE_S3_SECRET_KEY=
# OFFSITE_S3_REGION=auto
# OFFSITE_S3_PREFIX=simarc
# OFFSITE_S3_PATH_STYLE=true
