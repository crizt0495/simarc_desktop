# ── Build artifacts ──
tmp/
dist/*
/server
/simarc-server
*.exe
*.out
*.test
*.test.exe
build/bin/
frontend/dist/
# Toolchain & data runtime lokal (tidak ikut git)
toolchain/
mariadb-data/
*.deb
# Bundel database portabel (hasil unduhan) & cache build — tidak ikut git.
packaging/cache/
# Installer desktop Windows dilacak agar bisa diunduh langsung dari repo
# (pengecualian harus ditulis setelah "*.exe" agar menang).
# Hanya installer SATU FILE yang disimpan; biner mentah ada di build/bin/.
!dist/SIMARC-Setup.exe
!dist/SIMARC-Android.apk
# Payload build-time untuk packaging/winsetup (hasil cp build/bin/SIMARC.exe)
packaging/winsetup/payload/

# ── Node / frontend tooling ──
node_modules/

# ── Playwright artifacts ──
test-results/
playwright-report/
blob-report/
.playwright/

# ── Environment ──
.env*
# .env berisi konfigurasi database & WAJIB ikut di-push (permintaan pemilik proyek).
!.env
# Izinkan template .env tetap dilacak (contoh untuk server & klien).
!.env.example
!.env.client.example

# ── Runtime storage (regenerated) ──
storage/app/backups/*
storage/app/offsite/
storage/app/uploads/
storage/updates/
storage/qr-codes/*
public/storage/qr-codes/*
!storage/app/backups/.gitkeep
!storage/app/.gitkeep

# ── IDE ──
.idea/
.vscode/
*.swp
*.swo
*~

# ── OS ──
.DS_Store
Thumbs.db

# ── macOS app bundle symlink ──
SIMARC.app

# ── Screenshots / captures (local artifacts) ──
Screenshot_*.png
screen*.png

# Konfigurasi lokal berisi rahasia (password DB / token)
simarc-install.txt

# Installer di root repo (dilacak lewat LFS)
!/*.exe
!/*.deb
!dist/simarc_*.deb
